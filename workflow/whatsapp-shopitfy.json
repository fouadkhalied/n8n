{
  "name": "Chatflow - WhatsApp Shopify AI Assistant",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Verify (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2",
      "name": "Webhook Receive (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 500]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "3",
      "name": "Return Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "check-message",
              "leftValue": "={{ $json.body.entry[0].changes[0].value.messages[0].type }}",
              "rightValue": "text",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "4",
      "name": "Is Text Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 500]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {
          "responseCode": 200
        }
      },
      "id": "5",
      "name": "Ignore Non-Text",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 620]
    },
    {
      "parameters": {
        "jsCode": "const entry = $input.first().json.body.entry[0];\nconst change = entry.changes[0].value;\nconst message = change.messages[0];\nconst contact = change.contacts[0];\n\nreturn [{\n  json: {\n    whatsapp_message_id: message.id,\n    from_phone: message.from,\n    customer_name: contact?.profile?.name || 'Customer',\n    message_text: message.text.body,\n    phone_number_id: change.metadata.phone_number_id,\n    timestamp: message.timestamp\n  }\n}];"
      },
      "id": "6",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 480]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (whatsapp_id, from_phone, customer_name, content, phone_number_id, status, created_at)\nVALUES ('{{ $json.whatsapp_message_id }}', '{{ $json.from_phone }}', '{{ $json.customer_name }}', '{{ $json.message_text }}', '{{ $json.phone_number_id }}', 'processing', NOW())\nON CONFLICT (whatsapp_id) DO NOTHING\nRETURNING id, whatsapp_id;",
        "options": {}
      },
      "id": "7",
      "name": "Save Message (Idempotent)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [940, 480],
      "credentials": {
        "postgres": {
          "name": "Neon DB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "is-new",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      },
      "id": "8",
      "name": "Is New Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1160, 480]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {
          "responseCode": 200
        }
      },
      "id": "9",
      "name": "Respond 200 (Duplicate)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1380, 620]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  s.shopify_domain,\n  s.shopify_token,\n  p.title as product_title,\n  p.price,\n  p.inventory_quantity,\n  p.description\nFROM users u\nJOIN shopify_stores s ON s.user_id = u.id\nLEFT JOIN products p ON p.user_id = u.id\nWHERE u.whatsapp_phone_number_id = '{{ $('Extract Message Data').item.json.phone_number_id }}'\nLIMIT 50;",
        "options": {}
      },
      "id": "10",
      "name": "Fetch Shopify Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1380, 460],
      "credentials": {
        "postgres": {
          "name": "Neon DB"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  o.shopify_order_id,\n  o.order_number,\n  o.status,\n  o.total_price,\n  o.created_at,\n  o.tracking_url\nFROM orders o\nJOIN users u ON o.user_id = u.id\nWHERE u.whatsapp_phone_number_id = '{{ $('Extract Message Data').item.json.phone_number_id }}'\nAND o.customer_phone = '{{ $('Extract Message Data').item.json.from_phone }}'\nORDER BY o.created_at DESC\nLIMIT 5;",
        "options": {}
      },
      "id": "11",
      "name": "Fetch Customer Orders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1380, 560],
      "credentials": {
        "postgres": {
          "name": "Neon DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const shopifyData = $('Fetch Shopify Context').all();\nconst orderData = $('Fetch Customer Orders').all();\nconst msgData = $('Extract Message Data').first().json;\n\n// Build products context\nconst products = shopifyData.map(p => p.json).filter(p => p.product_title);\nconst orders = orderData.map(o => o.json);\n\nconst productsText = products.length > 0\n  ? products.map(p => `- ${p.product_title}: $${p.price} (Stock: ${p.inventory_quantity})`).join('\\n')\n  : 'No products found';\n\nconst ordersText = orders.length > 0\n  ? orders.map(o => `- Order #${o.order_number}: ${o.status} ($${o.total_price}) - ${o.tracking_url || 'No tracking'}`).join('\\n')\n  : 'No recent orders for this customer';\n\nconst systemPrompt = `You are a helpful customer support assistant for a Shopify store.\nAnswer customer questions about products, pricing, inventory, and order status.\nAlways be friendly, concise, and helpful.\nIf you don't know something, say so honestly.\n\nSTORE PRODUCTS:\n${productsText}\n\nCUSTOMER RECENT ORDERS:\n${ordersText}\n\nCustomer name: ${msgData.customer_name}\nRespond in the same language the customer uses.`;\n\nreturn [{\n  json: {\n    system_prompt: systemPrompt,\n    user_message: msgData.message_text,\n    from_phone: msgData.from_phone,\n    phone_number_id: msgData.phone_number_id,\n    whatsapp_message_id: msgData.whatsapp_message_id\n  }\n}];"
      },
      "id": "12",
      "name": "Build AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 480]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gemini-1.5-flash",
          "mode": "list"
        },
        "options": {
          "systemInstruction": "={{ $json.system_prompt }}"
        },
        "messages": {
          "values": [
            {
              "content": "={{ $json.user_message }}"
            }
          ]
        }
      },
      "id": "13",
      "name": "Gemini AI",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [1820, 480],
      "credentials": {
        "googlePalmApi": {
          "name": "Gemini API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $('Build AI Context').item.json.phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Build AI Context').item.json.from_phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"{{ $json.text }}\"\n  }\n}",
        "options": {}
      },
      "id": "14",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2040, 480],
      "credentials": {
        "httpHeaderAuth": {
          "name": "WhatsApp API Token"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE messages SET status = 'completed' WHERE whatsapp_id = '{{ $('Build AI Context').item.json.whatsapp_message_id }}';",
        "options": {}
      },
      "id": "15",
      "name": "Mark Processed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2260, 480],
      "credentials": {
        "postgres": {
          "name": "Neon DB"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {
          "responseCode": 200
        }
      },
      "id": "16",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2480, 480]
    }
